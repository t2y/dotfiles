ServerAliveInterval 30

Host USE-1PASSWORD
  IdentityAgent ~/.1password/agent.sock

Host hostN
  Hostname 192.168.0.N
  User USERNAME
  ProxyJump SSH-STEP

Host SOCKS-PROXY
  Hostname SSH-STEP
  User USERNAME
  ## socks proxy
  DynamicForward 1080
  ControlMaster no
  ControlPath none
  ForkAfterAuthentication no

Host *
  SetEnv TERM=xterm-256color # temporarily for ghostty
  ForwardAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%C
  ControlPersist 10
